        if (File.Exists(caminhoCompletoLocal) && ValidarInstalacaoAtual())
        {
            Console.WriteLine("Arquivo já existe localmente e está atualizado. Encerrando processo.");
            return;
        }

        Console.WriteLine("Arquivo ausente ou desatualizado. Iniciando download via mTLS...");

        try
