            handler.ClientCertificates.Add(certificadoCliente);

            // Passo 4: Realizar o download seguro via Stream
            using var client = new HttpClient(handler);
            using var response = await client.GetAsync(UrlCdnCloudFront, HttpCompletionOption.ResponseHeadersRead);
            
            response.EnsureSuccessStatusCode(); // Retornará 403 ou erro de SSL se o certificado falhar

            using (var streamParaBaixar = await response.Content.ReadAsStreamAsync())
            using (var arquivoLocalStream = new FileStream(caminhoCompletoLocal, FileMode.Create, FileAccess.Write, FileShare.None, 8192, true))
            {
                await streamParaBaixar.CopyToAsync(arquivoLocalStream);
            }

            // Passo 5: Validar integridade do binário baixado
            if (VerificarIntegridadeSha256(caminhoCompletoLocal, "HASH_ESPERADO_AQUI"))
            {
                Console.WriteLine("Download concluído com sucesso e arquivo verificado! Prosseguindo para instalação.");
