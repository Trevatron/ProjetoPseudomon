            }
            else
            {
                Console.WriteLine("Erro crítica: O arquivo baixado falhou na checagem de integridade SHA-256.");
                File.Delete(caminhoCompletoLocal);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Falha catastrófica no processo de download/autenticação: {ex.Message}");
        }
    }

